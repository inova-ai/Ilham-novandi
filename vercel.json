{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/binance.js": {
      "maxDuration": 10
    },
    "api/health.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/binance",
      "destination": "/api/binance.js"
    },
    {
      "source": "/api/health",
      "destination": "/api/health.js"
    }
  ]
}
